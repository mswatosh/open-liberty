-include= ~../cnf/resources/bnd/transform.props

Bundle-Name: Managed Concurrency Java21
Bundle-SymbolicName: com.ibm.ws.concurrent.java21
Bundle-Description: Application server-managed concurrency utilities for Java 21+; version=${bVersion}; Jakarta Enabled

-dsannotations: \
  com.ibm.ws.concurrent.internal.ConcurrencyService,\
  com.ibm.ws.concurrent.internal.java21.ContextServiceImpl,\
  com.ibm.ws.concurrent.internal.ManagedExecutorServiceImpl,\
  com.ibm.ws.concurrent.internal.ManagedScheduledExecutorServiceImpl

-dsannotations-inherit: true